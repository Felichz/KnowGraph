{
  "name": "rails-interview-graph",
  "productName": "Learning Workspace",
  "description": "Desktop learning workspace for guided React and Rails interview preparation.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:gateway": "esbuild server/index.js --bundle --platform=node --format=cjs --target=node20 --outfile=electron-dist/gateway.cjs",
    "desktop:dev": "electron .",
    "desktop:pack": "npm run build && npm run build:gateway && electron-builder --dir",
    "desktop:dist": "npm run build && npm run build:gateway && electron-builder",
    "preview": "vite preview",
    "audit:react": "node scripts/audit-react-graph.mjs",
    "test:logic": "node tests/logic/learning-controller.mjs && node tests/logic/topological-layout.mjs && node tests/logic/provider-settings.mjs && node tests/logic/paraphrase-ai.mjs && node tests/logic/background-tasks.mjs && node tests/logic/reading-chunks.mjs && node tests/logic/seniority-and-interview.mjs && node tests/logic/fixtures-contract.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run audit:react && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "dompurify": "^3.4.13",
    "dotenv": "^16.4.5",
    "idb": "^8.0.0",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.16.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.20",
    "esbuild": "^0.28.2",
    "vite": "^6.4.3"
  },
  "build": {
    "appId": "dev.felix.learningworkspace",
    "productName": "Learning Workspace",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
