{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai/[...path].js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/((?!api/ai(?:/|$)).*)", "destination": "/index.html" }
  ]
}
